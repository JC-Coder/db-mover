PORT=3000
NODE_ENV=development
DB_MOVER_DEPLOYMENT=hosted # hosted | self_hosted

# Telemetry (Optional)
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=

# Cloudflare R2 Storage (Required for hosted 1GB+ R2 exports, falls back to local /tmp in dev)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_s3_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_s3_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name

# Optional R2 Configuration
# R2_PRESIGNED_EXPIRES_SECONDS=7200 # Default: 2 hours (7200s)
